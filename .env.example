# Copy this file to .env and fill in real values. .env is gitignored.
# This single .env is used by docker-compose for every service, on every
# machine (laptop, desktop, VM) -- compose networking uses service names,
# not machine IPs, so nothing here should ever need to be machine-specific.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=coffeeexplorer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=coffeeexplorer
# Used by the backend container (service name "postgres" resolves via Docker DNS)
DATABASE_URL=postgresql://coffeeexplorer:changeme@postgres:5432/coffeeexplorer?schema=public

# --- Auth ---
JWT_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Set to true once the deployment has a domain + TLS (see DEPLOY.md's "About
# TLS" section) -- "secure" cookies are silently dropped by browsers over
# plain HTTP.
COOKIE_SECURE=false

# Single-user seed credentials (used once by prisma/seed.ts)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme-admin-password

# --- Frontend ---
# Only used by the containerized `frontend` service (the "container" compose
# profile, and prod). In normal dev the frontend runs natively on the host
# instead (see README) and reads frontend/coffee-explorer/.env.local, not
# this file.
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_INTERNAL_URL=http://backend:4000

# --- nginx ---
# What nginx proxies "/" to. Defaults to host.docker.internal:3000 (native
# frontend dev) if unset; docker-compose.prod.yml overrides this to
# "frontend:3000" once the frontend is containerized too.
FRONTEND_UPSTREAM=host.docker.internal:3000

# --- Deployment (docker-compose.prod.yml only) ---
# Your GitHub username/org, lowercase (GHCR image names must be lowercase).
GHCR_OWNER=changeme-github-username

# --- TLS (docker-compose.prod.yml only, see DEPLOY.md "About TLS") ---
# The domain proxied through Cloudflare in front of the VM.
DOMAIN=changeme.example.com
