server {
    listen 80;

    location /api/ {
        proxy_pass http://backend:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # FRONTEND_UPSTREAM points at the containerized "frontend" service in
        # prod, or at "host.docker.internal:3000" in dev (frontend runs
        # natively on the host there). Next.js's own rewrites() config
        # (next.config.ts) handles proxying /uploads/* through to the backend
        # from here -- no separate nginx location needed for it.
        proxy_pass http://${FRONTEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Next.js dev server HMR uses websockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
