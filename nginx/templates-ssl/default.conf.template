server {
    listen 80;
    server_name ${DOMAIN};

    # Cloudflare (Full/Full-strict mode) always reaches this VM over 443, so
    # in practice nothing but a direct IP hit lands here -- redirect it too.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Cloudflare Origin CA cert -- trusted by Cloudflare's edge (which is all
    # that ever talks to this VM directly), not by public browsers. See
    # DEPLOY.md's "About TLS" for how to generate and place these.
    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ {
        proxy_pass http://backend:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Next.js's own rewrites() config (next.config.ts) handles proxying
        # /uploads/* through to the backend from here -- no separate nginx
        # location needed for it.
        proxy_pass http://${FRONTEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Next.js dev server HMR uses websockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
